# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# Firebase Admin SDK
# 從 Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰 下載 JSON，
# 放到 backend/ 底下（已被 .gitignore 忽略），並填入相對或絕對路徑。
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Storage bucket 名稱，與前端 NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET 相同
# 例如 your_project.appspot.com 或 your_project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# 給 Gemini 做結構切分用的縮圖長邊像素（越小越省 token，建議 1024）
GEMINI_THUMB_MAX_PX=1024
# 存檔閱讀用的高解析渲染倍率（PDF 用，2.0 約等於 144dpi）
STORAGE_RENDER_ZOOM=2.0
